<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_bg">

    <!-- Barra superior -->
    <TextView
        android:id="@+id/tvAvatar"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_avatar_circle"
        android:gravity="center"
        android:text="MJ"
        android:textColor="@color/text_on_yellow"
        android:textStyle="bold"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/etBuscar"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_search_pill"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="8dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:hint="A dónde vas?"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:singleLine="true"
        android:inputType="text"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintTop_toTopOf="@id/tvAvatar"
        app:layout_constraintBottom_toBottomOf="@id/tvAvatar"
        app:layout_constraintStart_toEndOf="@id/tvAvatar"
        app:layout_constraintEnd_toStartOf="@id/ivBell"/>

    <ImageView
        android:id="@+id/ivBell"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_bell"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="@id/tvAvatar"
        app:layout_constraintBottom_toBottomOf="@id/tvAvatar"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Mapa -->
    <cl.conatacoch.colectivos.pasajero.RouteMapView
        android:id="@+id/routeMapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvAvatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/panelInferior"/>

    <ImageButton
        android:id="@+id/btnUbicacion"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_fab_circle"
        android:src="@drawable/ic_location"
        android:padding="9dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintEnd_toEndOf="@id/routeMapView"
        app:layout_constraintBottom_toBottomOf="@id/routeMapView"/>

    <!-- Panel inferior -->
    <LinearLayout
        android:id="@+id/panelInferior"
        android:layout_width="0dp"
        android:layout_height="340dp"
        android:orientation="vertical"
        android:background="@drawable/bg_card_panel"
        android:padding="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tvTituloParadero"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Paradero actual: Plaza de Armas (2 rutas)"
                android:textColor="@color/brand_yellow"
                android:textStyle="bold"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/btnCambiarParadero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cambiar paradero"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"/>
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="8dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupRutas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTodas"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Todas las rutas"
                    android:checked="true"
                    android:textColor="@color/white" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLinea105"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Línea 105 (Melipilla)"
                    android:textColor="@color/white" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLinea1"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Línea 1 (Santiago - Vitacura)"
                    android:textColor="@color/white" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMariaPinto"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="María Pinto (San Borja)"
                    android:textColor="@color/white" />

            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tvColectivosDisponiblesCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Colectivos disponibles en tu ruta"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginBottom="8dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvColectivos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
