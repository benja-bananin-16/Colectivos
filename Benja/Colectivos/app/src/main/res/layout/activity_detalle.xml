<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_bg"
    android:padding="16dp">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_back"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvTituloLinea"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginStart="10dp"
        tools:text="Línea 12 · Terminal La Reina"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/cardCapacidad"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_panel"
        android:padding="14dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_clock"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Llega en"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:layout_marginStart="8dp"/>
            <TextView
                android:id="@+id/tvEtaDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/taxi_yellow"
                android:textStyle="bold"
                android:textSize="16sp"
                tools:text="2 min"/>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/border_dark" android:layout_marginVertical="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Capacidad disponible"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_capacity_card"
                android:padding="10dp"
                android:layout_marginEnd="5dp">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_seat"/>
                <TextView
                    android:id="@+id/tvAsientosDetalle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginTop="6dp"
                    tools:text="3"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="asientos libres"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_capacity_card"
                android:padding="10dp"
                android:layout_marginStart="5dp">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_briefcase"/>
                <TextView
                    android:id="@+id/tvMaleteroDetalle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp"
                    tools:text="Disponible"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="maletero"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvPagarCon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pagar con"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toBottomOf="@id/cardCapacidad"
        app:layout_constraintStart_toStartOf="parent"/>

    <LinearLayout
        android:id="@+id/filaPago"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_payment_row"
        android:padding="12dp"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvPagarCon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_dollar_badge"
            android:gravity="center"
            android:text="$"
            android:textColor="@color/text_on_yellow"
            android:textStyle="bold"
            android:textSize="16sp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RutPay · BancoEstado"
                android:textColor="@color/white"
                android:textSize="13sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cuenta terminada en 4821"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/ivCheckPago"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_check"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvTotalLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Total a pagar"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginBottom="14dp"
        app:layout_constraintBottom_toTopOf="@id/btnReservar"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvTotalMonto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="22sp"
        tools:text="$750"
        app:layout_constraintBottom_toBottomOf="@id/tvTotalLabel"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnReservar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_yellow_button"
        android:text="Reservar y pagar"
        android:textColor="@color/text_on_yellow"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>