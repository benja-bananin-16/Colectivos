<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_bg">

    <!-- Barra superior -->
    <TextView
        android:id="@+id/tvAvatar"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_avatar_circle"
        android:gravity="center"
        android:text="MJ"
        android:textColor="@color/text_on_yellow"
        android:textStyle="bold"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/etBuscar"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_search_pill"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="8dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:hint="A dónde vas?"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:singleLine="true"
        android:inputType="text"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintTop_toTopOf="@id/tvAvatar"
        app:layout_constraintBottom_toBottomOf="@id/tvAvatar"
        app:layout_constraintStart_toEndOf="@id/tvAvatar"
        app:layout_constraintEnd_toStartOf="@id/ivBell"/>

    <ImageView
        android:id="@+id/ivBell"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_bell"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="@id/tvAvatar"
        app:layout_constraintBottom_toBottomOf="@id/tvAvatar"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Mapa -->
    <com.example.pasajero.ui.RouteMapView
        android:id="@+id/routeMapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvAvatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/panelInferior"/>

    <ImageButton
        android:id="@+id/btnUbicacion"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_fab_circle"
        android:src="@drawable/ic_location"
        android:padding="9dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintEnd_toEndOf="@id/routeMapView"
        app:layout_constraintBottom_toBottomOf="@id/routeMapView"/>

    <!-- Panel inferior -->
    <LinearLayout
        android:id="@+id/panelInferior"
        android:layout_width="0dp"
        android:layout_height="280dp"
        android:orientation="vertical"
        android:background="@drawable/bg_card_panel"
        android:padding="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Colectivos cerca de ti"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginBottom="10dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvColectivos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>